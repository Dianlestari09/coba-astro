---
export const prerender = false;

import { getDbServices } from "../../utils/dbService";
import Layout from "../../layouts/Main.astro";
import Pagination from "../../components/pagination.astro";
import ServiceCard from "../../components/card/ServiceCard.astro";

const allServices = await getDbServices();
const pageSize = 6;

// Get current page from query parameter (e.g. /service?page=2)
const url = new URL(Astro.request.url);
const currentPage = parseInt(url.searchParams.get('page') || '1');

// Calculate pagination
const lastPage = Math.max(1, Math.ceil(allServices.length / pageSize));
const startIndex = (currentPage - 1) * pageSize;
const endIndex = startIndex + pageSize;
const data = allServices.slice(startIndex, endIndex);

// Build page object compatible with Pagination component
const page = {
  data,
  currentPage,
  lastPage,
  url: {
    prev: currentPage > 1 ? `/service?page=${currentPage - 1}` : null,
    next: currentPage < lastPage ? `/service?page=${currentPage + 1}` : null,
  },
};
---

<Layout title="Service">
  <section class="section">
    <div class="container">
      <div class="breadcrumbs text-sm mb-6">
        <ul class="flex! flex-wrap">
          <li><a href="/">Home</a></li>
          <li>Service</li>
        </ul>
      </div>

      <ul
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-10 items-stretch"
      >
        {
          data.map((post) => (
            <li>
              <ServiceCard {...post} />
            </li>
          ))
        }
      </ul>

      {page.lastPage != 1 && <Pagination page={page} />}
    </div>
  </section>
</Layout>

